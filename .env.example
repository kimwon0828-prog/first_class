# Copy this file to .env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=YOUR_NAVER_MAP_CLIENT_ID
SMS_PROVIDER=
SMS_SEND_ENABLED=false
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_SENS_SMS_SERVICE_ID=
NCP_SENS_SMS_FROM_NUMBER=

# Toss Payments 자동결제(빌링) — API 개별 연동 키(ck/sk). 결제위젯 키(gck/gsk)가 아니다.
# https://developers.tosspayments.com/my/api-keys 의 "API 개별 연동 키"
TOSS_PAYMENTS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxx
TOSS_PAYMENTS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxx
# live 키를 쓰려면 명시적으로 1 을 넣어야 한다. 비워 두면 test 키만 허용한다.
TOSS_PAYMENTS_ALLOW_LIVE=
